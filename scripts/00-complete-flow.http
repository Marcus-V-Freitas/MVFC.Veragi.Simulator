?? status == 200
?? body data.scheduleQueryData.acquirers[0].paymentArrangements[0].receivableUnits[0].freeAmount == 0
?? js Math.round(response.parsedBody.data.scheduleQueryData.acquirers.flatMap(acquirer => acquirer.paymentArrangements.flatMap(arrangement => arrangement.receivableUnits)).reduce((sum, unit) => sum + unit.freeAmount, 0) * 100) == {{expectedFinalAgendaCents}}

