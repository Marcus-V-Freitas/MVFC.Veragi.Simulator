### 09 - Consultar explicitamente a agenda solicitada
# @name schedule
# @ref submitSchedule
GET {{root}}/schedules/query-requests/{{submitSchedule.data.requestId}}

?? status == 200
?? body data.status == PROCESSED

### 10 - Antecipar 25% de uma UR da agenda, deixando as demais intactas
# @name contract
# @ref schedule
# @injectVariables
{{
  const units = schedule.data.scheduleQueryData.acquirers.flatMap(acquirer => acquirer.paymentArrangements.flatMap(arrangement => arrangement.receivableUnits));
  const freeTotal = units.reduce((sum, unit) => sum + unit.freeAmount, 0);
  exports.originalAgendaFreeAmount = freeTotal;
  const originalUnit = units[0].freeAmount;
  const partial = Math.round(originalUnit * 0.25 * 100) / 100;
  exports.originalUnitFreeAmount = originalUnit;
  exports.partialAmount = partial;
  exports.expectedRemainingAgendaCents = Math.round((freeTotal - partial) * 100);
  exports.expectedFinalAgendaCents = Math.round((freeTotal - originalUnit) * 100);
  exports.requestedAmount = partial;
  exports.expectedRemaining = Math.round((originalUnit - partial) * 100) / 100;
  exports.acquirer = schedule.data.scheduleQueryData.acquirers[0].cnpj;
  exports.arrangement = schedule.data.scheduleQueryData.acquirers[0].paymentArrangements[0].code;
  exports.settlementDate = schedule.data.scheduleQueryData.acquirers[0].paymentArrangements[0].receivableUnits[0].settlementDate;
}}
POST {{root}}/contracts/anticipation
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ./payloads/contract.json

?? status == 201

### 11 - Processar pendencias de contrato no simulador
# @ref contract
POST {{baseUrl}}/_simulator/run

?? status == 200

### 12 - Consultar detalhes do contrato parcial
# @ref contract
GET {{root}}/contracts/by-external-reference?contractorCnpj={{cnpj}}&externalReference={{contract.data[0].externalReference}}

?? status == 200
?? body data.status == 1
?? body data.contractorCnpj == {{cnpj}}
?? body data.contractType == 2
?? body data.reachedGuarantees[0].acquirers[0].paymentArrangements[0].receivableUnits[0].reachedAmount == {{partialAmount}}

### 13 - Consultar saldo restante da primeira UR
# @name remainingSchedule
# @ref contract
GET {{root}}/schedules/query-requests/{{submitSchedule.data.requestId}}

?? status == 200
?? js response.parsedBody.data.scheduleQueryData.acquirers[0].paymentArrangements[0].receivableUnits[0].freeAmount == {{expectedRemaining}}
?? js Math.round(response.parsedBody.data.scheduleQueryData.acquirers.flatMap(acquirer => acquirer.paymentArrangements.flatMap(arrangement => arrangement.receivableUnits)).reduce((sum, unit) => sum + unit.freeAmount, 0) * 100) == {{expectedRemainingAgendaCents}}
?? js Object.is(JSON.stringify(response.parsedBody.data.scheduleQueryData.acquirers.flatMap(acquirer => acquirer.paymentArrangements.flatMap(arrangement => arrangement.receivableUnits)).slice(1)), JSON.stringify(schedule.data.scheduleQueryData.acquirers.flatMap(acquirer => acquirer.paymentArrangements.flatMap(arrangement => arrangement.receivableUnits)).slice(1))) == true

### 14 - Antecipar todo o saldo restante dessa UR
