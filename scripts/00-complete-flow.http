{{
  exports.requestedAmount = remainingSchedule.data.scheduleQueryData.acquirers[0].paymentArrangements[0].receivableUnits[0].freeAmount;
  exports.financierId = financierId + '-TOTAL';
}}
POST {{root}}/contracts/anticipation
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ./payloads/contract.json

?? status == 201

