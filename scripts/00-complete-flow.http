### 05 - Cadastrar estabelecimento e definir escopo
# @name merchant
# @injectVariables
{{
  exports.selectedAcquirerA = acquirers.data[0].cnpj;
  exports.selectedAcquirerB = acquirers.data[1].cnpj;
  exports.selectedArrangementA = arrangements.data[0].code;
  exports.selectedArrangementB = arrangements.data[1].code;
  exports.cnpj = String(Date.now()).padStart(14, '0');
  exports.financierId = 'HTTP-' + Date.now();
  exports.requestedAmount = 500;
  exports.today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
}}
POST {{root}}/merchants
Content-Type: application/json

< ./payloads/merchant-dynamic.json

?? status == 201

