# @import ../common.http

### Preparacao explicita - 01 - Cadastrar estabelecimento e definir escopo
# @name merchant
# @injectVariables
{{
  exports.cnpj = String(Date.now()).padStart(14, '0');
  exports.financierId = 'HTTP-' + Date.now();
  exports.requestedAmount = 500;
  exports.today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
}}
POST {{root}}/merchants
Content-Type: application/json

< ../payloads/merchant.json

?? status == 201

### Preparacao explicita - 02 - Gerar vendas de forma independente; nao dispara webhook
# @name generateSales
# @injectVariables
POST {{baseUrl}}/_simulator/merchants/{{cnpj}}/sales/generate
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/generate-sales.json

?? status == 201

### Preparacao explicita - 05 - Solicitar agenda; guardar requestId
# @name submitSchedule
# @injectVariables
POST {{root}}/schedules/query-requests
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 202

### Preparacao explicita - 06 - Aguardar scheduler ou antecipar processamento e entrega do webhook de agenda
# @name processSchedule
POST {{baseUrl}}/_simulator/run

?? status == 200

### Preparacao explicita - 08 - Consultar explicitamente a agenda solicitada
# @name schedule
GET {{root}}/schedules/query-requests/{{submitSchedule.data.requestId}}

?? status == 200
?? body data.status == PROCESSED

### Contratar todas as URs livres da agenda
# @name wholeContract
# @injectVariables
{{
  const guarantees = schedule.data.scheduleQueryData.acquirers.flatMap(a => a.paymentArrangements.flatMap(p => p.receivableUnits.filter(u => u.freeAmount > 0).map(u => ({receivableUnitHolderCnpj: cnpj, finalUserReceiverCnpj: cnpj, acquirerCnpj: a.cnpj, paymentArrangementCode: p.code, settlementDate: u.settlementDate, definedAmount: u.freeAmount}))));
  exports.guaranteesJson = JSON.stringify(guarantees);
  exports.requestedAmount = guarantees.reduce((sum, u) => sum + u.definedAmount, 0);
}}
POST {{root}}/contracts/anticipation
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/contract-entire-schedule.json

?? status == 201

### Registrar contrato e entregar webhook com todas as URs alcancadas
POST {{baseUrl}}/_simulator/run

?? status == 200

### Conferir total alcancado na consulta do contrato
GET {{root}}/contracts?contractorCnpj={{cnpj}}

?? status == 200
?? body data[0].reachedAmount == 200000



### Selecionar politica de saldo
PUT {{baseUrl}}/_simulator/contracts/availability
Content-Type: application/json

< ../payloads/contract-availability-deferred.json

?? status == 200

### Preparar tentativa sobre a primeira UR ja consumida
# @name deniedContract
# @injectVariables
{{
  exports.acquirer = schedule.data.scheduleQueryData.acquirers[0].cnpj;
  exports.arrangement = schedule.data.scheduleQueryData.acquirers[0].paymentArrangements[0].code;
  exports.settlementDate = schedule.data.scheduleQueryData.acquirers[0].paymentArrangements[0].receivableUnits[0].settlementDate;
  exports.requestedAmount = 1;
}}
POST {{root}}/contracts/anticipation
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/contract.json

?? status == 201

### Processar a recusa posterior
POST {{baseUrl}}/_simulator/run

?? status == 200

### Conferir contrato cancelado
GET {{root}}/contracts/by-external-reference?contractorCnpj={{cnpj}}&externalReference={{deniedContract.data[0].externalReference}}

?? status == 200
?? body data.status == 2

### Restaurar IMMEDIATE para as proximas chamadas
PUT {{baseUrl}}/_simulator/contracts/availability
Content-Type: application/json

< ../payloads/contract-availability-immediate.json

?? status == 200
