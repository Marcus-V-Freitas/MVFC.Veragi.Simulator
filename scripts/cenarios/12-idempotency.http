# @import ../common.http

### Preparacao explicita - 01 - Cadastrar estabelecimento e definir escopo
# @name merchant
# @injectVariables
{{
  exports.cnpj = String(Date.now()).padStart(14, '0');
  exports.financierId = 'HTTP-' + Date.now();
  exports.requestedAmount = 500;
  exports.today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
}}
POST {{root}}/merchants
Content-Type: application/json

< ../payloads/merchant.json

?? status == 201

###
# @name first
# @injectVariables
{{
  exports.key = require('crypto').randomUUID();
}}
POST {{root}}/schedules/query-requests
Idempotency-Key: {{key}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 202

### Mesma chave recupera mesma consulta
# @injectVariables
POST {{root}}/schedules/query-requests
Idempotency-Key: {{key}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 202
?? body data.requestId == {{first.data.requestId}}

### Nova chave com consulta ativa
# @injectVariables
POST {{root}}/schedules/query-requests
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 409

