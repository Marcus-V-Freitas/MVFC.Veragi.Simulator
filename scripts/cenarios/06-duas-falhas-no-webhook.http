# @import ../common.http

### Preparacao explicita - 01 - Cadastrar estabelecimento e definir escopo
# @name merchant
# @injectVariables
{{
  exports.cnpj = String(Date.now()).padStart(14, '0');
  exports.financierId = 'HTTP-' + Date.now();
  exports.requestedAmount = 500;
  exports.today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
}}
POST {{root}}/merchants
Content-Type: application/json

< ../payloads/merchant.json

?? status == 201

### Preparacao explicita - 02 - Gerar vendas de forma independente; nao dispara webhook
# @name generateSales
# @injectVariables
POST {{baseUrl}}/_simulator/merchants/{{cnpj}}/sales/generate
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/generate-sales.json

?? status == 201

### Preparar vendas e falhar nas proximas duas entregas da agenda
# @injectVariables
PUT {{baseUrl}}/_simulator/scenarios/schedule-webhook
Content-Type: application/json

{
  "failuresRemaining": 2,
  "failureStatusCode": 503
}

?? status == 200

### Preparacao explicita - 05 - Solicitar agenda; guardar requestId
# @name submitSchedule
# @injectVariables
POST {{root}}/schedules/query-requests
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 202

### Preparacao explicita - 06 - Aguardar scheduler ou antecipar processamento e entrega do webhook de agenda
# @name processSchedule
POST {{baseUrl}}/_simulator/run

?? status == 200

### Primeiro envio falha e fica persistido
GET {{baseUrl}}/_simulator/deliveries?kind=schedule&merchantCnpj={{cnpj}}

?? status == 200
?? js response.parsedBody[0].attempts == 1
?? js response.parsedBody[0].lastHttpStatus == 503

### Esperar backoff e repetir envio; segunda falha
{{
  await new Promise(resolve => setTimeout(resolve, 2200));
}}
POST {{baseUrl}}/_simulator/run

?? status == 200

### Esperar segundo backoff; terceira entrega funciona
{{
  await new Promise(resolve => setTimeout(resolve, 4200));
}}
POST {{baseUrl}}/_simulator/run

?? status == 200

### Inspecionar evento entregue depois das duas falhas
GET {{baseUrl}}/_simulator/deliveries?kind=schedule&merchantCnpj={{cnpj}}

?? status == 200
?? js response.parsedBody[0].attempts == 3
?? js response.parsedBody[0].delivered == true


