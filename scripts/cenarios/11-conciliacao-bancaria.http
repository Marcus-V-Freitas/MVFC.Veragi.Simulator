# @import ../common.http

### Preparacao explicita - 01 - Cadastrar estabelecimento e definir escopo
# @name merchant
# @injectVariables
{{
  exports.cnpj = String(Date.now()).padStart(14, '0');
  exports.financierId = 'HTTP-' + Date.now();
  exports.requestedAmount = 500;
  exports.today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
}}
POST {{root}}/merchants
Content-Type: application/json

< ../payloads/merchant.json

?? status == 201

### Preparacao explicita - 02 - Gerar vendas de forma independente; nao dispara webhook
# @name generateSales
# @injectVariables
POST {{baseUrl}}/_simulator/merchants/{{cnpj}}/sales/generate
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/generate-sales.json

?? status == 201

### Preparacao explicita - 05 - Solicitar agenda; guardar requestId
# @name submitSchedule
# @injectVariables
POST {{root}}/schedules/query-requests
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/schedule.json

?? status == 202

### Preparacao explicita - 06 - Aguardar scheduler ou antecipar processamento e entrega do webhook de agenda
# @name processSchedule
POST {{baseUrl}}/_simulator/run

?? status == 200

### Preparacao explicita - 08 - Consultar explicitamente a agenda solicitada
# @name schedule
GET {{root}}/schedules/query-requests/{{submitSchedule.data.requestId}}

?? status == 200
?? body data.status == PROCESSED

### Criar contrato para uma UR da agenda
# @name contract
# @injectVariables
{{
  const a = schedule.data.scheduleQueryData.acquirers[0];
  const p = a.paymentArrangements[0];
  const u = p.receivableUnits[0];
  exports.acquirer = a.cnpj;
  exports.arrangement = p.code;
  exports.settlementDate = u.settlementDate;
  exports.requestedAmount = 100;
}}
POST {{root}}/contracts/anticipation
Idempotency-Key: {{$guid}}
Content-Type: application/json

< ../payloads/contract.json

?? status == 201

### Processar contrato
POST {{baseUrl}}/_simulator/run

?? status == 200

### Registrar pagamento parcial de 40 usando apenas o payload do Swagger
# @name firstEntry
# @injectVariables
{{
  exports.entryId = require('crypto').randomUUID();
  exports.reconciliationAmount = 40;
}}
POST {{root}}/reconciliation/entry
Content-Type: application/json

< ../payloads/reconciliation-fixed-entry.json

?? status == 201

### Repetir o mesmo entryId: deve recusar sem novo registro
POST {{root}}/reconciliation/entry
Content-Type: application/json

< ../payloads/reconciliation-fixed-entry.json

?? status == 400

### Novo pagamento de 70: alocar 60 restantes e conservar 10 sem associacao
# @injectVariables
{{
  exports.reconciliationAmount = 70;
}}
POST {{root}}/reconciliation/entry
Content-Type: application/json

< ../payloads/reconciliation.json

?? status == 201

### Conferir pagamentos e rateio da parcela sem duplicar o valor alcancado
GET {{baseUrl}}/_simulator/reconciliation/entries?merchantCnpj={{cnpj}}

?? status == 200
?? js response.parsedBody.length == 2
?? js response.parsedBody.reduce((sum, entry) => sum + entry.unallocatedAmount, 0) == 10
?? js response.parsedBody.flatMap(entry => entry.receivables).reduce((sum, unit) => sum + unit.amount, 0) == 100
?? js response.parsedBody[0].receivables[0].holderCnpj == {{cnpj}}
?? js response.parsedBody[0].receivables[0].settlementDate == {{settlementDate}}
